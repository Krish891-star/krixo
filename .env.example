# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SITE_URL=https://krixo.netlify.app

# MongoDB Atlas — replace placeholders locally; never commit real credentials
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER_HOST/YOUR_DATABASE?retryWrites=true&w=majority

# JWT
JWT_SECRET=YOUR_GENERATED_SECRET

# Admin
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD

TRUST_PROXY=false
CORS_ORIGINS=
